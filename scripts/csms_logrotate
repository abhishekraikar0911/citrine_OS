# =============================================================================
# CitrineOS CSMS — Logrotate Configuration
# =============================================================================
# Installation:
#   sudo ln -sf /opt/csms/scripts/csms_logrotate /etc/logrotate.d/csms
#   sudo logrotate -d /etc/logrotate.d/csms   # dry-run test
# =============================================================================

# OCPP Communication Logs
/opt/csms/ocpp-logs/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    maxsize 100M
    create 0644 root root
    sharedscripts
    postrotate
        # No service reload needed — OCPP logger writes new files independently
        true
    endscript
}

# Backup & Temp Text Files
/opt/csms/backup_temp_files/*.txt
/opt/csms/backup_temp_files/*.log {
    weekly
    missingok
    rotate 4
    compress
    delaycompress
    notifempty
    maxsize 50M
    create 0644 root root
}

# CSMS Maintenance & Monitoring Logs (generated by our scripts)
/var/log/csms_maintenance.log
/var/log/csms_disk_monitor.log
/var/log/csms_volume_audit.log {
    weekly
    missingok
    rotate 8
    compress
    delaycompress
    notifempty
    maxsize 50M
    create 0644 root root
    sharedscripts
}
